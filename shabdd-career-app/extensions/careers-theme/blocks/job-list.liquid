  #career-job-list-{{ block.id }} .career-job-summary { align-items: center; display: grid; grid-template-columns: minmax(0,1fr) auto; margin-bottom: 12px; padding: 18px; }
  #career-job-list-{{ block.id }} .career-job-summary h2 { font-size: 22px; line-height: 28px; margin: 0 0 6px; }
  #career-job-list-{{ block.id }} .career-round-icon { background: #e5f6ff; color: #1797e8; font-size: 15px; height: 54px; width: 54px; }
  #career-job-list-{{ block.id }} .career-job-tags { gap: 9px; margin-top: 7px; }
  #career-job-list-{{ block.id }} .career-job-tags span { background: #f9fbff; border-color: #c9d9ef; border-radius: 7px; color: #1e315a; font-size: 12px; padding: 5px 14px; }
  #career-job-list-{{ block.id }} .career-apply-now { background: #fff; border: 1px solid #1769ff; color: #1769ff; min-width: 150px; }
  #career-job-list-{{ block.id }} .career-section { padding: 18px; }
  #career-job-list-{{ block.id }} .career-section-heading { margin-bottom: 10px; }
  #career-job-list-{{ block.id }} .career-small-icon { background: #eaf2ff; border-radius: 9px; color: #1769ff; font-size: 13px; height: 40px; width: 40px; }
  #career-job-list-{{ block.id }} .career-small-icon.orange { background: #fff0df; color: #f97316; }
  #career-job-list-{{ block.id }} .career-section-heading h2 { font-size: 18px; line-height: 24px; margin: 0; }
  #career-job-list-{{ block.id }} .career-section-heading p { font-size: 13px; margin-top: 2px; }
  #career-job-list-{{ block.id }} .career-detail-grid { gap: 12px; margin: 14px 0 0; }
  #career-job-list-{{ block.id }} .career-detail-card { min-height: 170px; padding: 19px; }
  #career-job-list-{{ block.id }} .career-detail-card strong { font-size: 13px; margin: 13px 0 17px; }
  #career-job-list-{{ block.id }} .career-detail-card > span:not(.career-detail-icon) { font-size: 18px; font-weight: 950; line-height: 22px; }
  #career-job-list-{{ block.id }} .career-rich-text { align-items: flex-start; border-top: 0; display: grid; gap: 14px; grid-template-columns: 42px minmax(0,1fr); margin-top: 14px; padding: 18px; }
  #career-job-list-{{ block.id }} .career-rich-text h3 { font-size: 18px; line-height: 23px; margin-bottom: 4px; }
  #career-job-list-{{ block.id }} .career-rich-text p { color: #334a75; font-size: 14px; line-height: 20px; white-space: pre-line; }
  #career-job-list-{{ block.id }} .career-rich-text p::first-letter { text-transform: uppercase; }
  #career-job-list-{{ block.id }} .career-form { grid-template-columns: minmax(0,1fr) minmax(0,1fr); }
  #career-job-list-{{ block.id }} .career-form .career-section { align-self: start; }
  #career-job-list-{{ block.id }} .career-form .career-section { grid-column: 1 / -1; }
