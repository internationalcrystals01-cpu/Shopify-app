  #career-job-list-{{ block.id }} [data-career-list-view] .career-layout, #career-job-list-{{ block.id }} [data-career-detail-view] .career-layout { grid-template-columns: 1fr; }
  #career-job-list-{{ block.id }} .career-card { border-color: #dce8f7; border-radius: 10px; box-shadow: 0 18px 50px rgba(40, 86, 140, .07); }
