  #career-job-list-{{ block.id }} .career-notice { border-radius: 7px; font-size: 14px; font-weight: 700; padding: 12px 14px; }
  #career-job-list-{{ block.id }} .career-notice.success { background: #ecfdf5; border: 1px solid #b5ead2; color: #08784f; }
  #career-job-list-{{ block.id }} .career-notice.error { background: #fff1f2; border: 1px solid #fecdd3; color: #be123c; }
  #career-job-list-{{ block.id }} .career-success-overlay { position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center; padding: 20px; background: rgba(7, 20, 54, .42); }
  #career-job-list-{{ block.id }} .career-success-overlay[hidden] { display: none; }
  #career-job-list-{{ block.id }} .career-success-modal { width: min(420px, 100%); padding: 30px 28px; border: 1px solid #b5ead2; border-radius: 10px; background: #fff; box-shadow: 0 28px 90px rgba(7, 20, 54, .28); text-align: center; }
  #career-job-list-{{ block.id }} .career-success-icon { align-items: center; background: #dcfce7; border-radius: 50%; color: #15803d; display: inline-flex; font-size: 30px; font-weight: 900; height: 58px; justify-content: center; margin-bottom: 16px; width: 58px; }
  #career-job-list-{{ block.id }} .career-success-modal h2 { color: #071436; font-size: 22px; font-weight: 850; line-height: 28px; margin: 0; }
  #career-job-list-{{ block.id }} .career-success-modal p { color: #4b587c; font-size: 14px; line-height: 21px; margin: 8px 0 0; }

  #career-job-list-{{ block.id }} { background: radial-gradient(circle at 88% 35%, rgba(219, 234, 254, .72), transparent 34%), linear-gradient(180deg, #f7fbff 0%, #eef7ff 100%); color: #071436; min-height: 100vh; }
  #career-job-list-{{ block.id }} .career-hero { background: linear-gradient(90deg, rgba(239,247,255,.98) 0%, rgba(230,241,255,.72) 42%, rgba(247,250,255,.10) 70%), url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=2200&q=85") center 42%/cover; min-height: 210px; padding: 34px 20px 28px; }
  #career-job-list-{{ block.id }} .career-hero-inner { position: relative; }
  #career-job-list-{{ block.id }} .career-hero-copy { max-width: 760px; }
  #career-job-list-{{ block.id }} .career-hero p:not(.career-hero-note) { color: #071436; font-size: 13px; font-weight: 950; letter-spacing: .24em; margin: 0 0 10px; text-transform: uppercase; }
  #career-job-list-{{ block.id }} .career-hero h1 { color: #071436; font-size: clamp(34px, 5vw, 50px); font-weight: 950; letter-spacing: 0; line-height: 1.04; margin: 0; max-width: 720px; }
  #career-job-list-{{ block.id }} .career-hero h1 span { color: #7765ff; display: inline; font-size: inherit; line-height: inherit; margin: 0; max-width: none; }
